{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Debug single integration test",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=orcapod",
                    "--test",
                    "model"
                ],
                "filter": {
                    "kind": "test"
                }
            },
            "args": [
                "--exact",
                "--nocapture",
                "hash_pod"
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Debug integration tests within file",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=orcapod",
                    "--test",
                    "model"
                ],
                "filter": {
                    "kind": "test"
                }
            },
            "args": [
                "--exact",
                "--nocapture",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Debug unit tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=orcapod"
                ],
                "filter": {
                    "name": "orcapod",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Debug executable",
            "cargo": {
                "args": [
                    "build",
                    "--package=orcapod",
                    "--bin=exe_file_stem"
                ],
            },
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Debug unit tests in executable",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=orcapod",
                    "--bin=exe_file_stem"
                ],
            },
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Python: Debug smoke test",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "package_orcapod_python",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "program": "tests/extra/python/smoke_test.py",
            "args": [
                "./tests/.tmp"
            ]
        },
        {
            "name": "Python: Debug agent test",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "package_orcapod_python",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "program": "tests/extra/python/agent_start_test.py",
            // "program": "tests/extra/python/agent_watch_test.py",
            // "program": "tests/extra/python/agent_pub_test.py",
        }
    ]
}
